# Menu links land with the section heading visible below the sticky header
diff --git a/index.html b/index.html
index 8feda0c..d36f07a 100644
--- a/index.html
+++ b/index.html
@@ -448,6 +448,16 @@
 <script src="size-guide.js"></script>
 <script src="basket.js"></script>
 <script src="christmas-set.js"></script>
+<script>
+  // How tall the sticky header is right now, so a menu link lands with the
+  // section heading showing rather than under the header (styles.css).
+  (function () {
+    var h = document.querySelector(".site-header");
+    function set() { if (h) document.documentElement.style.setProperty("--header-h", h.offsetHeight + "px"); }
+    set();
+    window.addEventListener("resize", set);
+  })();
+</script>
 
 <!-- GoatCounter: counts the visit and the page, nothing else. No cookies,
      no profile, no following anyone across the internet. The privacy page
diff --git a/styles.css b/styles.css
index ad80d37..b62cdf7 100644
--- a/styles.css
+++ b/styles.css
@@ -60,6 +60,10 @@ a{ color: var(--ink); }
 
 /* ===== Header ===== */
 .site-header{ padding:16px 0; position:sticky; top:0; background:rgba(237,231,219,.94); backdrop-filter:blur(8px); z-index:20; border-bottom:2px solid var(--ink); }
+/* The sticky header covers the top of whatever a menu link jumps to (on a phone
+   it is over 200px tall), so the section's heading ended up hidden behind it.
+   --header-h is measured on the page (index.html); 150px is the fallback. */
+section[id]{ scroll-margin-top:calc(var(--header-h, 150px) + 8px); }
 .header-row{ display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
 .wordmark{ display:flex; align-items:center; gap:9px; font-family:var(--display); font-weight:600; font-size:1.3rem; color:var(--ink); text-decoration:none; letter-spacing:-0.02em; }
 .wordmark img{ width:34px; height:auto; display:block; }
