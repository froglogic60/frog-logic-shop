From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 09:02:15 +0100
Subject: [PATCH] Taster sign-up counter: Resend log to a Desk line [skip
 netlify]

---
 automation/planner/taster-count.js | 71 ++++++++++++++++++++++++++++++
 1 file changed, 71 insertions(+)
 create mode 100644 automation/planner/taster-count.js

diff --git a/automation/planner/taster-count.js b/automation/planner/taster-count.js
new file mode 100644
index 0000000..14d99fa
--- /dev/null
+++ b/automation/planner/taster-count.js
@@ -0,0 +1,71 @@
+// Counts Bespoke Planner taster sign-ups (23 Oct 2026). The only record of a
+// taster is the email the function sent, so this reads Resend's send log
+// (read-only, the same key the newsletter uses), keeps every "your page is
+// ready" email it has ever seen in taster-signups.json (Resend's list only
+// reaches back so far, so the file is the long-term memory), and writes one
+// line on the Desk: total, this week, last sign-up. Runs daily from
+// .github/workflows/taster-count.yml.
+//
+// Env: RESEND_API_KEY
+const fs = require("fs");
+const path = require("path");
+
+const KEY = process.env.RESEND_API_KEY;
+if (!KEY) { console.error("Missing env: RESEND_API_KEY"); process.exit(1); }
+const STATE = path.join(__dirname, "taster-signups.json");
+const CALENDAR = path.join(__dirname, "..", "..", "content", "calendar.json");
+const SUBJECT = /your page is ready/i;
+const TEST_ADDRESSES = new Set(["hello@froglogic.co.uk", "samanthajhall@live.co.uk"]);
+
+async function recentEmails() {
+  // Resend lists the most recent sends, newest first; walk pages while it offers them.
+  const out = [];
+  let after = "";
+  for (let page = 0; page < 10; page++) {
+    const r = await fetch(`https://api.resend.com/emails?limit=100${after ? "&after=" + after : ""}`, { headers: { Authorization: "Bearer " + KEY } });
+    if (!r.ok) throw new Error("Resend " + r.status + " " + (await r.text()).slice(0, 200));
+    const j = await r.json();
+    const data = j.data || [];
+    out.push(...data);
+    if (!j.has_more || !data.length) break;
+    after = data[data.length - 1].id;
+  }
+  return out;
+}
+
+(async () => {
+  const state = fs.existsSync(STATE) ? JSON.parse(fs.readFileSync(STATE, "utf8")) : { signups: [] };
+  const seen = new Set(state.signups.map((s) => s.id));
+  const emails = await recentEmails();
+  let added = 0;
+  for (const e of emails) {
+    if (!SUBJECT.test(e.subject || "") || seen.has(e.id)) continue;
+    const to = (Array.isArray(e.to) ? e.to[0] : e.to || "").toLowerCase();
+    if (!to || TEST_ADDRESSES.has(to)) continue; // Sam's own test runs don't count
+    state.signups.push({ id: e.id, to, at: e.created_at });
+    seen.add(e.id);
+    added++;
+  }
+  state.signups.sort((a, b) => a.at.localeCompare(b.at));
+  state.updated = new Date().toISOString();
+  fs.writeFileSync(STATE, JSON.stringify(state, null, 2) + "\n");
+
+  const now = Date.now();
+  const week = state.signups.filter((s) => now - Date.parse(s.at) < 7 * 86400e3).length;
+  const last = state.signups.length ? state.signups[state.signups.length - 1].at.slice(0, 10) : "none yet";
+  const uniq = new Set(state.signups.map((s) => s.to)).size;
+  const line = `Taster sign-ups: ${uniq} people (${state.signups.length} pages), ${week} this week, last ${last}`;
+
+  try {
+    const cal = JSON.parse(fs.readFileSync(CALENDAR, "utf8"));
+    const date = new Date().toISOString().slice(0, 10);
+    let day = cal.days.find((d) => d.date === date);
+    if (!day) { day = { date, items: [] }; cal.days.push(day); cal.days.sort((a, b) => a.date.localeCompare(b.date)); }
+    day.items = day.items.filter((i) => !/^Taster sign-ups:/.test(i.what));
+    day.items.push({ what: line, who: "robot" });
+    cal.updated = date;
+    fs.writeFileSync(CALENDAR, JSON.stringify(cal, null, 2) + "\n");
+  } catch (e) { console.warn("Desk not updated:", e.message); }
+
+  console.log(line + ` (${added} new since last run, ${emails.length} emails read)`);
+})().catch((e) => { console.error(e); process.exit(1); });
