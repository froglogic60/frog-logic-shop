+/* The Pond Guides, read on the page (22 Oct 2026) */
+.guide-body{ max-width:72ch; margin:44px 0 0; font-size:1.02rem; line-height:1.6; }
+.guide-body h2{ font-family:"Fraunces",serif; font-size:1.35rem; margin:1.8em 0 .5em; }
+.guide-body h3{ font-size:.8rem; letter-spacing:.08em; text-transform:uppercase; margin:0 0 .4em; color:var(--muted); }
+.guide-body ul{ padding-left:1.2em; margin:0 0 1em; }
+.guide-body li{ margin:0 0 .45em; }
+.guide-note{ font-size:.8rem; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); margin:-.3em 0 .8em; }
+.guide-wrong{ margin:0 0 1em; }
+.guide-wrong div{ display:grid; grid-template-columns:minmax(0,2fr) minmax(0,3fr); gap:16px; padding:10px 0; border-top:1px solid var(--line); }
+.guide-wrong div:last-child{ border-bottom:1px solid var(--line); }
+.guide-wrong dt{ font-style:italic; color:var(--muted); }
+.guide-wrong dd{ margin:0; }
+.guide-helps{ columns:2; column-gap:28px; }
+.guide-responses{ display:grid; grid-template-columns:1fr 1fr; gap:24px; margin:0 0 1em; }
+.guide-closing{ font-family:"Fraunces",serif; font-style:italic; font-size:1.25rem; margin:1.6em 0; padding-left:18px; border-left:4px solid var(--gold); }
+.guide-next{ color:var(--muted); font-size:.95rem; }
+.guide-disclaimer{ font-size:.8rem; color:var(--muted); }
+body.low-stim .guide-closing{ border-left-color:var(--ink); }
+@media (max-width:640px){
+  .guide-wrong div, .guide-responses{ grid-template-columns:1fr; gap:6px; }
+  .guide-helps{ columns:1; }
+}
