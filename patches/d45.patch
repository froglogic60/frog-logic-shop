+  return `
+<section class="page">
+  <div class="head"><div><div class="kick">PRINT · CUT · STICK</div><h1>My day</h1><p class="sub">Put a picture card in each box, in order. Tick each one when it's done.</p></div><img class="frog" src="${frog}"></div>
