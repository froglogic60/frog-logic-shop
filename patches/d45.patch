+  ${foot}
+</section>
+<section class="page">
+  <div class="kick">ONE THING AT A TIME</div><h2>Now and next</h2>
+  <div class="nn"><div><div class="ftl">Now</div><div class="nnb"></div></div><div class="arrow">→</div><div><div class="ftl">Next</div><div class="nnb"></div></div></div>
